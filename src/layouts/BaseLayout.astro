---
import BaseHead from '../components/BaseHead.astro';

interface Props {
  title: string;
  /** BCP 47 tag for <html lang>; pages that are not articles stay English. */
  htmlLang?: string;
  ogLocale?: string;
  /** Emitted as <link rel="alternate" hreflang>; empty for untranslated pages. */
  langAlternates?: { hreflang: string; path: string }[];
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  schema?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  schema,
  htmlLang = 'en',
  ogLocale = 'en_US',
  langAlternates = [],
} = Astro.props;

const SITE_URL = 'https://faq.college';

// The chatbot takes a plain locale code, not a BCP 47 region tag — the rest of
// the fleet passes `en` / `zh-CN`, so a Chinese reader gets a Chinese assistant.
const botLang = htmlLang.startsWith('zh') ? 'zh-CN' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta property="og:locale" content={ogLocale} />
    <!-- Translation pairing: tells search engines these two URLs are the same
         article in different languages, so neither is treated as duplicate or
         off-language content and each is served to the right audience. -->
    {
      langAlternates.map(alt => (
        <link
          rel="alternate"
          hreflang={alt.hreflang}
          href={new URL(alt.path, SITE_URL).toString()}
        />
      ))
    }
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      schema={schema}
    />
    <style is:global>
      @import '../styles/global.css';
    </style>
      <!-- Unified lead conversion entry: assessment form, chat, sticky buttons, and in-article cards -->
    <script src="https://chat.faq.college/lead.js?v=20260702-routefix" data-site="faq-college" data-lang={botLang} data-tier="country" data-country="us" data-apply-base="https://apply.faq.college" data-color="#d98c5f" data-accent="#1f6b3a" async></script>
    <!-- Chat widget for lead consultation actions -->
    <script src="https://chat.faq.college/assistant.js" data-site="faq-college" data-lang={botLang} data-bot-name="College FAQ Assistant" data-channel="organic" data-color="#d98c5f" data-accent="#1f6b3a" async data-no-bubble="1"></script>
</head>
  <body>
    <!-- Nav: centered-overlay (logo center, links flanking) -->
    <nav class="nav" id="nav">
      <div class="row left"><a href="#dim">Topics</a><a href="#articles">Latest</a></div>
      <a href="/" class="brand">College FAQ Desk<small>Straight Answers</small></a>
      <div class="row right"><a href="/about/">About</a><a href="/about/">Ask</a></div>
      <button type="button" class="hamb" id="hamb" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开导航菜单">
        <span></span><span></span><span></span>
      </button>
      <div class="mobile-menu" id="mobile-menu">
        <a href="#dim">Topics</a>
        <a href="#articles">Latest</a>
        <a href="/about/">About</a>
        <a href="/about/">Ask</a>
      </div>
    </nav>
    <script>
      const hamb = document.getElementById('hamb');
      const nav = document.getElementById('nav');
      const menu = document.getElementById('mobile-menu');
      hamb?.addEventListener('click', () => {
        const open = hamb.getAttribute('aria-expanded') === 'true';
        hamb.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('menu-open', !open);
      });
      menu?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          hamb?.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('menu-open');
        });
      });
    </script>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer>
      <div class="foot-grid">
        <div class="foot-brand">
          <b>College FAQ Desk</b>
          <p>Straight answers to your college questions — no marketing fluff, just well-researched facts about applications, financial aid, scholarships, and campus life.</p>
        </div>
        <div>
          <h4>Topics</h4>
          <a href="/category/applications/">Applications</a>
          <a href="/category/financial-aid/">Financial Aid</a>
          <a href="/category/scholarships/">Scholarships</a>
          <a href="/category/standardized-tests/">Tests &amp; Scores</a>
          <a href="/category/campus-life/">Campus Life</a>
        </div>
        <div>
          <h4>Resources</h4>
          <a href="/about/">About</a>
          <a href="#dim">Categories</a>
          <a href="#articles">Latest Articles</a>
        </div>
        <div>
          <h4>Info</h4>
          <a href="/about/">About Us</a>
          <a href="/about/">Contact</a>
        </div>
      </div>
      <div class="foot-bottom">
        <span>&copy; 2026 College FAQ Desk. Independent educational resource.</span>
        <span>Not affiliated with any university.</span>
      </div>
    </footer>
<!-- Chat widget -->
        <!-- Centralized lead entry: sticky buttons, desktop pill, and in-article cards -->
</body>
</html>
